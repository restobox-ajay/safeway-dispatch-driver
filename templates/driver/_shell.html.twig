{#
    The Online switch. Exactly one per page (app.js drives the first [data-online-toggle]); a page that shows
    a title in the top bar instead (Analytics, Profile — as their mockups) renders it elsewhere or hidden, so
    GPS pings keep going while the driver is Online.
#}
{% macro online_toggle(driver, attrs = '') %}
        <div class="online-toggle{{ driver.online ?? false ? ' is-online' }}" data-online-toggle
             role="switch" aria-checked="{{ driver.online ?? false ? 'true' : 'false' }}" tabindex="0"{{ attrs|raw }}>
            <span class="switch"></span>
            <span class="online-toggle-label"></span>
        </div>
{% endmacro %}
