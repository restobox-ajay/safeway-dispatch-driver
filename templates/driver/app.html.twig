{% extends 'driver/base.html.twig' %}
{% import 'driver/_shell.html.twig' as shell %}
{#
    The signed-in app frame (FEATURE-194), from the mockups' shared chrome (app.js CHROME_TEMPLATES):
    top bar (menu, messages, Online toggle, right-hand action), drawer, Connectivity panel, messages
    screen, bottom tabs. Pages fill `content`; `tab` picks the active bottom tab.
#}
{# A page that just reloaded the driver from /me passes it as shell_driver (the user was loaded before that). #}
{% set driver = shell_driver ?? app.user.driver %}
{% set dispatch_phone = driver.dispatch_phone ?? dispatch_phone_fallback %}


{% block screen %}
    {% block topbar %}
    <div class="driver-topbar">
        <div class="topbar-side topbar-side-left">
            {% block topbar_left %}
            <button class="topbar-icon-btn" type="button" aria-label="Open menu" data-sidebar-open>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <button type="button" class="topbar-icon-btn messages-btn" data-messages-open aria-label="Messages">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <span class="messages-badge" data-messages-badge hidden></span>
            </button>
            {% endblock %}
        </div>
        {% block topbar_center %}{{ shell.online_toggle(driver) }}{% endblock %}
        <div class="topbar-side topbar-side-right">
            {% block topbar_right %}{% endblock %}
        </div>
    </div>
    {% endblock %}

    {% block above_content %}{% endblock %}

    <div class="app-content">
        <div class="alert alert-warning" data-offline-banner hidden style="margin-bottom:10px;"></div>
        {# GitHub #47: "GPS not updating" while Online with an old fix (app.js); tapping it opens Connectivity. #}
        <button type="button" class="alert alert-warning gps-stale-banner" data-gps-stale data-network-status-open hidden></button>
        {% block content %}{% endblock %}
    </div>

    {% set tab = tab|default('tasks') %}
    <nav class="bottom-nav">
        <a href="{{ path('app_driver_tasks') }}"{{ tab == 'tasks' ? ' class="active"' }}><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s7-7.58 7-12a7 7 0 1 0-14 0c0 4.42 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg></span>Tasks</a>
        <a href="{{ path('app_driver_analytics') }}"{{ tab == 'analytics' ? ' class="active"' }}><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="20" x2="4" y2="12"/><line x1="12" y1="20" x2="12" y2="6"/><line x1="20" y1="20" x2="20" y2="16"/></svg></span>Analytics</a>
        {% if dispatch_phone %}
            <a href="tel:{{ dispatch_phone|replace({' ': ''}) }}"><span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg></span>Call Dispatch</a>
        {% endif %}
    </nav>

    {# Nav drawer #}
    <div class="sidebar-overlay" data-sidebar-overlay hidden>
        <aside class="sidebar-drawer">
            <div class="sidebar-drawer-header">
                <span class="sidebar-drawer-title">Menu</span>
                <button type="button" class="topbar-icon-btn" data-sidebar-close aria-label="Close menu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <nav class="sidebar-drawer-nav">
                <a href="{{ path('app_driver_profile') }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                    Profile
                </a>
                <a href="{{ path('app_driver_analytics') }}">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="20" x2="4" y2="12"/><line x1="12" y1="20" x2="12" y2="6"/><line x1="20" y1="20" x2="20" y2="16"/></svg>
                    Analytics
                </a>
                <button type="button" class="network-status-btn" data-network-status-open aria-label="Connectivity">
                    <svg class="network-status-icon" data-network-status-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 8.5a15.3 15.3 0 0 1 20 0"/><path d="M5.5 12.5a10.3 10.3 0 0 1 13 0"/><path d="M9 16.5a5.3 5.3 0 0 1 6 0"/><circle cx="12" cy="20" r="1"/></svg>
                    Connectivity
                </button>
                {% if driver_gps_tester %}
                <button type="button" data-gps-tester-open>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><line x1="12" y1="2" x2="12" y2="6"/><line x1="12" y1="18" x2="12" y2="22"/><line x1="2" y1="12" x2="6" y2="12"/><line x1="18" y1="12" x2="22" y2="12"/></svg>
                    GPS Test
                </button>
                {# Testing only: pick an admin delivery zone and its centre is reported as the location (app.js). #}
                <div class="sidebar-test-zone">
                    <label for="gps-test-zone">Test location: zone</label>
                    <select id="gps-test-zone" data-gps-test-zone>
                        <option value="">Choose a zone…</option>
                    </select>
                </div>
                {% endif %}
                <div class="sidebar-drawer-divider"></div>
                <a href="{{ path('app_driver_logout') }}" class="sidebar-drawer-danger">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                    Log Out
                </a>
            </nav>
        </aside>
    </div>

    {# Connectivity panel + Report app issue (FEATURE-204) #}
    <div class="confirm-overlay" data-network-status-overlay hidden>
        <div class="confirm-modal">
            <div class="network-status-user">User ID: <span class="cell-mono">{{ driver.employee_card_number ?? '—' }}</span> ({{ driver.name ?? '' }})</div>
            <h3>Connectivity</h3>
            <div class="network-status-rows">
                <div class="network-status-row"><span>Internet</span><span class="network-status-value" data-net-value="internet">…</span></div>
                <div class="network-status-row"><span>Dispatch Server</span><span class="network-status-value" data-net-value="dispatch">…</span></div>
                <div class="network-status-meta" data-net-meta="dispatch"></div>
                <div class="network-status-row"><span>GPS</span><span class="network-status-value" data-net-value="gps">…</span></div>
                <div class="network-status-meta" data-net-meta="gps"></div>
                <div class="network-status-row"><span>Saved on this phone</span><span class="network-status-value" data-net-value="pending">0</span></div>
            </div>
            <div class="alert alert-danger" data-network-status-warning hidden style="margin-top:12px;">All photos and route progress are saved, and pushed to Dispatch server when connectivity resumes.</div>
            <div class="network-report">
                <h3 style="margin-top:0;">Report Issue</h3>
                <div class="form-group">
                    <label for="network-report-type">Type</label>
                    <select id="network-report-type" data-network-report-type>
                        <option value="connectivity">Connectivity</option>
                        <option value="app_function">App Function</option>
                        <option value="camera">Camera / Photo</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div class="form-group mb-0">
                    <label for="network-report-detail">Detail</label>
                    <textarea id="network-report-detail" data-network-report-detail rows="3" placeholder="What's going on?"></textarea>
                </div>
                <button type="button" class="btn btn-primary btn-block" style="margin-top:10px;" data-network-report-submit>Submit</button>
                <p class="text-faint" data-network-report-sent hidden style="margin:8px 0 0;text-align:center;">Sent to Dispatch. Thanks!</p>
            </div>
        </div>
    </div>

    {% if driver_gps_tester %}
    {# GPS tester: sends fake location pings (test servers only, DRIVER_GPS_TESTER=1). #}
    <div class="confirm-overlay" data-gps-tester-overlay hidden>
        <div class="confirm-modal gps-tester">
            <h3>GPS Location Reporting</h3>
            <div class="network-status-rows">
                <div class="network-status-row"><span>Last Location Reported</span><span class="network-status-value cell-mono" data-gps-tester-last>None yet</span></div>
                <div class="network-status-meta" data-gps-tester-ago></div>
            </div>

            <div class="form-group">
                <label for="gps-tester-place">Choose</label>
                <div class="gps-tester-line">
                    <select id="gps-tester-place" data-gps-tester-place>
                        <option value="49.261111,-123.113889">Vancouver 49.261111, -123.113889</option>
                        <option value="49.1044,-122.8011">Surrey 49.1044, -122.8011</option>
                    </select>
                    <button type="button" class="btn btn-primary" data-gps-tester-place-go>Go</button>
                </div>
            </div>

            <div class="form-group">
                <label for="gps-tester-distance">Move</label>
                <div class="gps-tester-line">
                    <select id="gps-tester-distance" aria-label="Distance" data-gps-tester-distance>
                        {% for n in [1, 2, 5, 10, 25, 50, 100, 250, 500] %}
                        <option value="{{ n }}"{% if n == 100 %} selected{% endif %}>{{ n }}</option>
                        {% endfor %}
                    </select>
                    <select aria-label="Unit" data-gps-tester-unit>
                        <option value="1" selected>m</option>
                        <option value="1000">km</option>
                    </select>
                    <select aria-label="Direction" data-gps-tester-direction>
                        <option value="north">North</option>
                        <option value="south">South</option>
                        <option value="east">East</option>
                        <option value="west">West</option>
                    </select>
                    <button type="button" class="btn btn-primary" data-gps-tester-move>Go</button>
                </div>
            </div>

            <div class="form-group">
                <label>Custom</label>
                <div class="gps-tester-line">
                    <input type="number" step="any" inputmode="decimal" placeholder="Lat" aria-label="Latitude" data-gps-tester-lat>
                    <input type="number" step="any" inputmode="decimal" placeholder="Long" aria-label="Longitude" data-gps-tester-lng>
                    <button type="button" class="btn btn-primary" data-gps-tester-custom-go>Go</button>
                </div>
            </div>

            <p class="text-faint" data-gps-tester-mode style="margin:0 0 10px;"></p>
            <div class="confirm-modal-actions">
                <button type="button" class="btn btn-secondary" data-gps-tester-real>Use real GPS</button>
                <button type="button" class="btn btn-secondary" data-close>Close</button>
            </div>
        </div>
    </div>
    {% endif %}

    {# Messages screen (FEATURE-200) #}
    <div class="messages-overlay" data-messages-overlay hidden>
        <div class="messages-panel">
            <div class="messages-header">
                <button type="button" class="topbar-icon-btn" data-messages-close aria-label="Back">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                </button>
                <span class="messages-title">Messages</span>
                <button type="button" class="topbar-icon-btn messages-star-filter" data-messages-star-filter aria-label="Show starred only" aria-pressed="false">
                    <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                </button>
            </div>
            <div class="messages-list" data-messages-list></div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script>
        window.FVST = {
            csrf: {{ csrf_token('driver_action')|json_encode|raw }},
            driverId: {{ app.user.id|json_encode|raw }},
            urls: {
                login: {{ path('app_driver_login')|json_encode|raw }},
                base: {{ path('app_driver_home')|json_encode|raw }}
            }
        };
    </script>
    <script src="/driver-app/js/app.js" defer></script>
    {% block page_scripts %}{% endblock %}
{% endblock %}
