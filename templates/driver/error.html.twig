{% extends app.user ? 'driver/app.html.twig' : 'driver/base.html.twig' %}

{% block title %}Safeway Driver{% endblock %}
{% block page_title %}{{ offline ? 'No connection' : 'Something went wrong' }}{% endblock %}

{% block content %}
    <div class="card center">
        <p role="alert">{{ message }}</p>
        <a class="btn btn-primary btn-block" href="">{{ offline ? 'Try again' : 'Reload' }}</a>
        {% if app.user %}
            <a class="btn btn-secondary btn-block mt" href="{{ path('app_driver_tasks') }}">Upcoming Destinations</a>
        {% endif %}
    </div>
{% endblock %}

{# Signed out (base layout): the same message in the plain frame. #}
{% block screen %}
    {% if app.user %}
        {{ parent() }}
    {% else %}
        <main class="page"><div class="app-content">{{ block('content') }}</div></main>
    {% endif %}
{% endblock %}
