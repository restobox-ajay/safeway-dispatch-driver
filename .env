# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> domains ###
# FEATURE-091 / SPEC.md:72 / OQ-006 — separate-domain mode.
# FEATURE-131 (review C17 / ADR-029, amends ADR-019): these are now REQUIRED — the app
# fails to boot unless both are set, because framework.trusted_hosts is derived from them
# (an empty value would compile to a match-all regex and silently disable host protection).
# For SINGLE-domain mode set BOTH to the same host (dev default = localhost; override in
# .env.local, e.g. auth.localhost). To serve admin and user on SEPARATE domains for
# cookie/origin isolation, set them to the respective hostnames (e.g.
# ADMIN_DOMAIN=admin.example.com, APP_DOMAIN=app.example.com). They are matched as host
# regexes by the security firewalls AND fold into trusted_hosts; routing each host to this
# app is handled at the proxy layer (Caddy/nginx) — infrastructure config.
ADMIN_DOMAIN=localhost
APP_DOMAIN=localhost
# Domain attribute for the session + remember-me cookies. Leave EMPTY to scope
# cookies to the exact host that set them (per-host isolation).
SESSION_COOKIE_DOMAIN=
###< domains ###

###> symfony/mailer ###
MAILER_DSN=null://null
MAILER_FROM=noreply@example.com
###< symfony/mailer ###

###> doctrine/doctrine-bundle ###
# ====================================================================================
# THIS APPLICATION IS SQLITE-ONLY. Do NOT set DATABASE_URL to MySQL, MariaDB,
# PostgreSQL, or any other engine — the schema, every migration, and several DBAL-only
# tables (login_attempts, endpoint_rate_limits, sessions) assume SQLite. See ADR-001 /
# ADR-013. Connecting with anything else fails fast at boot with a clear error
# (App\Doctrine\SqlitePragmaMiddleware) rather than silently misbehaving, but don't
# rely on that — just don't change this line.
# ====================================================================================
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
###< doctrine/doctrine-bundle ###

# Deliberate duplicate, OUTSIDE the Flex markers above so a future `composer
# recipes:update` regenerating that block (which may reintroduce MySQL examples or
# comment this out) cannot change the effective value — .env is parsed top-to-bottom
# and the LAST definition of a key wins. Still SQLite-only. See the block above.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> fvstexpress driver web app (docs/DRIVER_APP.md) ###
# The fvstexpress-admin driver API. Must end with /driver-api/v1/
#   Local WAMP : http://fvstexpress-admin.local/driver-api/v1/
#   Live       : https://your-admin-domain/driver-api/v1/
DRIVER_API_BASE_URL=
# Only when the base URL is an IP address: the admin vhost name to send as the Host header.
DRIVER_API_HOST_HEADER=
# "Call Dispatch" number until the admin API's /me sends one.
DISPATCH_PHONE=
# The business timezone: "now" on the task cards day bar (the server itself runs in UTC).
DRIVER_TIMEZONE=America/Vancouver
###< fvstexpress driver web app ###
