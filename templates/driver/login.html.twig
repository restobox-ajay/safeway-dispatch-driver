{% extends 'driver/base.html.twig' %}
{# Driver login at /login: phone number or employee number + PIN, checked by the Safeway Driver API (POST /auth/login). #}

{% block title %}Log In — Safeway Driver{% endblock %}

{% block screen %}
<div class="login-screen">
    <div class="login-brand">
        <img src="/driver-app/img/safeway-logo.png" alt="Safeway Tire" width="72" height="72">
        <h1>Safeway Tire</h1>
        <p class="text-faint">Driver</p>
    </div>

    <div class="card">
        {% if error %}
            <div class="alert alert-danger" id="login-error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" action="{{ path('app_driver_login') }}" novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('driver_login') }}">
            <div class="form-group">
                <label for="login">Phone Number or Employee #</label>
                <input type="text" id="login" name="login" class="input" value="{{ last_username }}"
                       autocomplete="username" autocapitalize="characters" required{{ last_username ? '' : ' autofocus' }}>
            </div>
            <div class="form-group">
                <label for="pin">PIN</label>
                <input type="password" id="pin" name="pin" class="input" inputmode="numeric" maxlength="8" autocomplete="current-password" required{{ last_username ? ' autofocus' : '' }}>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Log In</button>
        </form>
        <p class="text-faint center mt">Forgot your PIN? Contact dispatch.</p>
    </div>
</div>
{% endblock %}

{% block scripts %}
    {# Signed out: the previous driver's pages must not stay readable offline on a shared phone. #}
    <script>
        if (navigator.serviceWorker && navigator.serviceWorker.getRegistration) {
            navigator.serviceWorker.getRegistration('/driver/').then(function (reg) {
                var sw = reg && (reg.active || reg.waiting);
                if (sw) sw.postMessage('clear-pages');
            }).catch(function () {});
        }
    </script>
{% endblock %}
