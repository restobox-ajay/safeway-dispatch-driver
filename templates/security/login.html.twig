{% extends 'base.html.twig' %}

{# Themed like the fvstexpress-admin sign-in page (templates/admin/security/login.html.twig there). #}
{% block title %}Sign In{% endblock %}

{% block body %}
<h1>Sign in</h1>
<p class="auth-subtitle text-faint">Staff access to the FVST Express driver web app. Drivers: <a href="{{ path('app_driver_login') }}">driver login</a>.</p>

{% if error %}
    <div class="alert alert-danger error" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
{% endif %}

{% for message in app.flashes('error') %}
    <div class="alert alert-danger error">{{ message }}</div>
{% endfor %}

{% for message in app.flashes('success') %}
    <div class="alert alert-success success">{{ message }}</div>
{% endfor %}

<form method="post" action="{{ path('app_login') }}">
    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
    <div class="form-group">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="{{ last_username }}" placeholder="you@fvstexpress.com" autocomplete="email" required autofocus>
    </div>
    <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="••••••••" autocomplete="current-password" required>
    </div>
    <div class="auth-links-inline">
        <span></span>
        <a href="{{ path('app_forgot_password') }}">Forgot your password?</a>
    </div>
    <div class="checkbox-row" style="margin-bottom:18px;">
        <input type="checkbox" id="remember_me" name="_remember_me">
        <label for="remember_me">Remember me</label>
    </div>
    <button type="submit" class="btn btn-primary btn-block">Sign in</button>
</form>

<div class="auth-links">
    <a href="{{ path('app_resend_verification') }}">Didn't get your verification email? Resend it</a>
</div>
{% endblock %}
