{% set cur = app.request.attributes.get('_route') %}
<div class="sidebar-brand-row"><a href="{{ path('app_dashboard') }}" class="brand"><span class="brand-mark">FV</span> <span class="brand-text">{{ app.user.name|default('My Account') }}</span></a></div>
<nav class="sidebar-nav">
    <div class="sidebar-section-label">Account</div>
    <a href="{{ path('app_dashboard') }}" class="{{ cur == 'app_dashboard' ? 'active' }}">Dashboard</a>
    <a href="{{ path('app_account_settings') }}" class="{{ cur == 'app_account_settings' ? 'active' }}">Settings</a>
    <a href="{{ path('app_account_change_password') }}" class="{{ cur == 'app_account_change_password' ? 'active' }}">Change Password</a>
    <a href="{{ path('app_account_sessions') }}" class="{{ cur == 'app_account_sessions' ? 'active' }}">Active Sessions</a>
    <a href="{{ path('app_account_login_history') }}" class="{{ cur == 'app_account_login_history' ? 'active' }}">Login History</a>
    {% if pat_available is defined and pat_available %}
    <a href="{{ path('app_account_tokens') }}" class="{{ cur == 'app_account_tokens' ? 'active' }}">API Tokens</a>
    {% endif %}
    {% if two_factor_available is defined and two_factor_available %}
    <a href="{{ path('app_2fa_setup') }}" class="{{ cur == 'app_2fa_setup' ? 'active' }}">Two-Factor Auth</a>
    {% endif %}

    <div class="sidebar-divider"></div>
    <a href="{{ path('app_logout') }}">Logout</a>
</nav>
