{% extends 'driver/app.html.twig' %}
{% import 'driver/_stop.html.twig' as ui %}
{#
    Figma "List Deliveries" (Upcoming Destinations), the spec's main page: the next deliveries, starting from the
    immediate next, with the estimated time. Each card: Company (opens Google Maps), #stop, Address (Google Maps),
    Type, Products, and Details / Add Note / Complete. Above them each route of the day with Start / Finish.
#}

{% block title %}Upcoming Destinations — Safeway Driver{% endblock %}
{% block crumbs %} / <span>Upcoming Destinations</span>{% endblock %}
{% block page_title %}Upcoming Destinations{% endblock %}

{% block content %}
    {% for r in routes %}
        <section class="card route-card" data-route="{{ r.ref }}">
            <div class="route-head">
                <div>
                    <div class="route-name">{{ r.name }}</div>
                    <div class="text-faint">{{ r.status|capitalize }}{{ r.truck ? ' · ' ~ r.truck }} · {{ r.left }} left</div>
                </div>
                {% if 'start' in r.next_allowed %}
                    <button type="button" class="btn btn-primary btn-sm" data-route-tap="start" data-route-ref="{{ r.ref }}">Start Route</button>
                {% elseif 'finish' in r.next_allowed %}
                    <button type="button" class="btn btn-success btn-sm" data-route-tap="finish" data-route-ref="{{ r.ref }}">Finish Route</button>
                {% endif %}
            </div>
            {% if r.status == 'planned' and r.start_blocked and 'start' not in r.next_allowed %}
                <p class="alert alert-warning mb0">{{ r.start_blocked }}</p>
            {% endif %}
        </section>
    {% endfor %}

    <div class="card list-card">
        {% for s in cards %}
            <article class="stop-card{{ s.id == next_id ? ' is-next' }}" data-stop-id="{{ s.id }}">
                <div class="field">
                    <div class="field-label row-between">
                        <span>Company:</span>
                        <span class="stop-no">{% if s.id == next_id %}<span class="next-tag">Next</span> {% endif %}#{{ s.position }}</span>
                    </div>
                    <div class="field-value">{% if s.rush %}<span class="rush" title="Rush">⚑</span> {% endif %}{{ ui.company(s) }}</div>
                </div>
                <div class="field">
                    <div class="field-label">Address:</div>
                    <div class="field-value">{{ ui.address(s) }}</div>
                </div>
                <div class="field">
                    <div class="field-label">Type:</div>
                    <div class="field-value">{{ s.types ?: (s.warehouse ? 'Reload' : '—') }}</div>
                </div>
                <div class="field">
                    <div class="field-label">Products:</div>
                    <div class="field-value">{{ ui.products(s) }}</div>
                </div>
                <div class="field">
                    <div class="field-label">Estimated Time:</div>
                    <div class="field-value">ETA {{ s.eta ?: '–' }}{{ s.window ? ' · window ' ~ s.window }} {{ ui.status(s) }}</div>
                </div>
                <div class="card-buttons">
                    <a class="btn btn-primary btn-sm" href="{{ path('app_driver_stop', {id: s.id}) }}">Details</a>
                    {% if 'note' in s.next_allowed %}
                        <a class="btn btn-warning btn-sm" href="{{ path('app_driver_note', {id: s.id}) }}">Add Note</a>
                    {% endif %}
                    {% if 'complete' in s.next_allowed %}
                        <a class="btn btn-success btn-sm" href="{{ path('app_driver_complete', {id: s.id}) }}">Complete</a>
                    {% endif %}
                </div>
            </article>
        {% else %}
            <p class="empty">{{ routes is empty ? 'No route for you today.' : 'All stops are done.' }}</p>
        {% endfor %}
        {% if total > 0 %}{{ ui.pager('app_driver_tasks', page, pages, from, to, total) }}{% endif %}
    </div>
{% endblock %}

{% block page_scripts %}<script src="/driver-app/js/stop.js" defer></script>{% endblock %}
