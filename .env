# Committed defaults. Real values go in the gitignored .env.local (never commit APP_SECRET).
APP_ENV=dev
APP_SECRET=
# This app's own host (trusted_hosts).
APP_DOMAIN=localhost
# safeway-dispatch's Driver API — must end with /driver-api/v1/
DRIVER_API_BASE_URL=
# Only when the base URL is an IP address: the safeway-dispatch vhost name to send as the Host header.
DRIVER_API_HOST_HEADER=
# Proxies in front of this app (comma list), so the driver's IP and HTTPS are seen. Empty = none.
TRUSTED_PROXIES=
# Test servers only: 1 adds the GPS tester to the menu (fake positions). Leave 0 in production.
DRIVER_GPS_TESTER=0
