<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %} — FVST Express Driver</title>
        <link rel="icon" href="data:image/svg+xml,{{ '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" rx="7" fill="#5b8bf5"/><text x="16" y="21" font-size="13" font-weight="700" text-anchor="middle" fill="#fff" font-family="Arial">FV</text></svg>'|url_encode }}">
        {% block stylesheets %}
        {# Theme: the fvstexpress-admin app's (its public/assets/css/style.css + app.css bridge, copied unchanged),
           so staff pages here look like the admin app. Signed out = its centered sign-in card; signed in = its
           sidebar shell. The driver pages (/driver) have their own phone layout in templates/driver/. #}
        <link rel="stylesheet" href="/assets/css/style.css">
        <link rel="stylesheet" href="/assets/css/app.css">
        <link rel="stylesheet" href="/assets/css/boilerplate.css">
        {% endblock %}

        {% block javascripts %}
        {% endblock %}

        {% set frankenphpHotReload = app.request.server.get('FRANKENPHP_HOT_RELOAD') %}
        {% if frankenphpHotReload %}
        <meta name="frankenphp-hot-reload:url" content="{{ frankenphpHotReload }}">
        <script src="https://cdn.jsdelivr.net/npm/idiomorph"></script>
        <script src="https://cdn.jsdelivr.net/npm/frankenphp-hot-reload/+esm" type="module"></script>
        {% endif %}
    </head>
    <body>
        {% if app.session is defined and app.session.get('_impersonating_as') is not null %}
        <div class="alert alert-warning impersonation-banner">
            <span>Impersonating: {{ app.session.get('_impersonating_as') }}
            (as {{ app.session.get('_impersonating_by') }})</span>
            <form method="post" action="{{ path('app_impersonate_exit') }}" style="display:inline">
                <input type="hidden" name="_token" value="{{ csrf_token('impersonate_exit') }}">
                <button type="submit" class="btn btn-sm exit-impersonation-btn">Exit Impersonation</button>
            </form>
        </div>
        {% endif %}
        {% if app.session is defined and app.session.get('_impersonating_admin_as') is not null %}
        <div class="alert alert-warning admin-impersonation-banner">
            <span>Impersonating Admin: {{ app.session.get('_impersonating_admin_as') }}
            (as {{ app.session.get('_impersonating_admin_by') }})</span>
            <form method="post" action="{{ path('app_admin_impersonate_admin_exit') }}" style="display:inline">
                <input type="hidden" name="_token" value="{{ csrf_token('admin_impersonate_exit') }}">
                <button type="submit" class="btn btn-sm exit-admin-impersonation-btn">Exit Admin Impersonation</button>
            </form>
        </div>
        {% endif %}
        {# Nav follows the authenticated ENTITY (the security boundary), not a role string. #}
        {% set navType = app.user is instanceof('App\\Entity\\Admin') ? 'admin'
            : (app.user is instanceof('App\\Entity\\User') ? 'user' : null) %}
        {% if navType %}
        <div class="admin-shell">
            <aside class="sidebar" id="app-sidebar">
                {% include navType == 'admin' ? 'layout/_admin_nav.html.twig' : 'layout/_user_nav.html.twig' %}
            </aside>
            <div class="admin-main">
                <header class="admin-topbar">
                    <div style="display:flex;align-items:center;gap:12px;">
                        <button class="nav-toggle" type="button" aria-label="Toggle navigation" aria-controls="app-sidebar" aria-expanded="false" data-nav-toggle>☰</button>
                        <span class="admin-topbar-title">{{ block('title') }}</span>
                    </div>
                    <span class="text-faint" style="font-size:12px;">{{ app.user.name|default(app.user.userIdentifier) }}</span>
                </header>
                <main class="page-wrap main">{% block body %}{% endblock %}</main>
            </div>
        </div>
        <script>
            (function () {
                var btn = document.querySelector('[data-nav-toggle]');
                var bar = document.getElementById('app-sidebar');
                if (!btn || !bar) return;
                btn.addEventListener('click', function () {
                    var open = bar.classList.toggle('open');
                    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
                });
            })();
        </script>
        {% else %}
        <div class="auth-shell">
            <div class="auth-brand"><span class="auth-brand-mark">FV</span> FVST Express<small>Driver App Admin</small></div>
            <main class="auth-card main">
                {{ block('body') }}
            </main>
            <div class="auth-footer-link">{% block auth_footer %}Internal staff access only.{% endblock %}</div>
        </div>
        {% endif %}
    </body>
</html>
