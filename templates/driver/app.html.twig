{% extends 'driver/base.html.twig' %}
{#
    The signed-in frame, from the Figma driver frames (List Deliveries, Destination Details, Mark Delivery Complete,
    Completed Deliveries, Add Notes): a white top bar with the menu button on the left and the driver's name (with
    Log out) on the right, then the breadcrumb and the large page title, then white cards on light grey.
    Pages fill `crumbs`, `page_title` and `content`; `tab` marks the drawer entry.
#}
{% set tab = tab|default('upcoming') %}

{% block screen %}
    <header class="topbar">
        <button class="icon-btn" type="button" aria-label="Open menu" data-sidebar-open>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        </button>
        <div class="topbar-right">
            <button type="button" class="icon-btn messages-btn" data-messages-open aria-label="Messages">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                <span class="badge-count" data-messages-badge hidden></span>
            </button>
            <details class="user-menu">
                <summary>{{ app.user.name ?: 'Driver' }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg></summary>
                <div class="user-menu-list">
                    <a href="{{ path('app_driver_hours') }}">Work Hours</a>
                    <a href="{{ path('app_driver_logout') }}" class="text-danger" data-logout>Log Out</a>
                </div>
            </details>
        </div>
    </header>

    <main class="page">
        <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href="{{ path('app_driver_tasks') }}">Home</a>
            {% block crumbs %}{% endblock %}
        </nav>
        <h1 class="page-title">{% block page_title %}{% endblock %}</h1>

        <div class="app-content">
            <div class="alert alert-warning" data-offline-banner hidden></div>
            <button type="button" class="alert alert-warning gps-stale-banner" data-gps-stale data-network-status-open hidden></button>
            {% block content %}{% endblock %}
        </div>
    </main>

    {# Bottom tabs, as in a phone app; `tab` marks the active one. #}
    <nav class="bottom-nav" aria-label="Main">
        <a href="{{ path('app_driver_tasks') }}"{{ tab == 'upcoming' ? ' class="active" aria-current="page"' }}>
            <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s7-7.58 7-12a7 7 0 1 0-14 0c0 4.42 7 12 7 12z"/><circle cx="12" cy="10" r="2.5"/></svg></span>
            Upcoming
        </a>
        <a href="{{ path('app_driver_completed') }}"{{ tab == 'completed' ? ' class="active" aria-current="page"' }}>
            <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="8 12.5 11 15.5 16 9.5"/></svg></span>
            Completed
        </a>
        <button type="button" data-messages-open>
            <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
            Messages
            <span class="badge-count" data-messages-badge hidden></span>
        </button>
        <a href="{{ path('app_driver_hours') }}"{{ tab == 'hours' ? ' class="active" aria-current="page"' }}>
            <span class="nav-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><polyline points="12 7 12 12 15.5 14"/></svg></span>
            Hours
        </a>
    </nav>

    {# Toast host inside the frame: SWD.toast() uses an existing [data-toast] before adding its own to <body>. #}
    <div class="toast" data-toast role="status"></div>

    {# Menu drawer #}
    <div class="sidebar-overlay" data-sidebar-overlay hidden>
        <aside class="sidebar-drawer">
            <div class="sidebar-brand">
                <img src="/driver-app/img/safeway-logo.png" alt="" width="40" height="40">
                <span>Safeway Tire</span>
                <button type="button" class="icon-btn" data-sidebar-close aria-label="Close menu">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                </button>
            </div>
            <nav class="sidebar-nav">
                <a href="{{ path('app_driver_tasks') }}"{{ tab == 'upcoming' ? ' class="active"' }}>Upcoming Destinations</a>
                <a href="{{ path('app_driver_completed') }}"{{ tab == 'completed' ? ' class="active"' }}>Completed Destinations</a>
                <button type="button" data-messages-open>Messages <span class="badge-count" data-messages-badge hidden></span></button>
                <a href="{{ path('app_driver_hours') }}"{{ tab == 'hours' ? ' class="active"' }}>Work Hours</a>
                <button type="button" data-network-status-open>Connectivity &amp; Report a Problem</button>
                {% if driver_gps_tester %}
                <button type="button" data-gps-tester-open>GPS Test</button>
                {% endif %}
                <a href="{{ path('app_driver_logout') }}" class="text-danger" data-logout>Log Out</a>
            </nav>
        </aside>
    </div>

    {# Connectivity + Report a problem (POST /problems) #}
    <div class="confirm-overlay" data-network-status-overlay hidden>
        <div class="confirm-modal">
            <h3>Connectivity</h3>
            <div class="net-rows">
                <div class="net-row"><span>Internet</span><span class="net-value" data-net-value="internet">…</span></div>
                <div class="net-row"><span>Dispatch Server</span><span class="net-value" data-net-value="dispatch">…</span></div>
                <div class="net-meta" data-net-meta="dispatch"></div>
                <div class="net-row"><span>GPS</span><span class="net-value" data-net-value="gps">…</span></div>
                <div class="net-meta" data-net-meta="gps"></div>
                <div class="net-row"><span>Saved on this phone</span><span class="net-value" data-net-value="pending">0</span></div>
            </div>
            <div class="alert alert-danger" data-network-status-warning hidden>Photos and stop updates are saved on this phone and sent to Dispatch when the connection is back.</div>
            <h3>Report a Problem</h3>
            <div class="form-group">
                <label for="problem-kind">Type</label>
                <select id="problem-kind" class="input" data-problem-kind>
                    <option value="connectivity">Connection</option>
                    <option value="camera">Camera</option>
                    <option value="other">Something else</option>
                </select>
            </div>
            <div class="form-group">
                <label for="problem-text">Detail</label>
                <textarea id="problem-text" class="input" rows="3" maxlength="2000" data-problem-text></textarea>
            </div>
            <button type="button" class="btn btn-primary btn-block" data-problem-submit>Send to Dispatch</button>
            <p class="text-faint center" data-problem-sent hidden>Sent to Dispatch.</p>
            <button type="button" class="btn btn-secondary btn-block mt" data-close>Close</button>
        </div>
    </div>

    {% if driver_gps_tester %}
    {#
        GPS tester (test servers only, DRIVER_GPS_TESTER=1), as fvstexpress-driver's: sends a chosen location as the
        driver's position (POST /positions) instead of the phone's GPS, so Dispatch's map, the truck icon, the
        stationary alert and the tracking page can be tried from a desk. "Test location" lists today's stops and the
        warehouse (Safeway has no delivery zones); picking one reports its position.
    #}
    <div class="confirm-overlay" data-gps-tester-overlay hidden>
        <div class="confirm-modal gps-tester">
            <h3>GPS Location Reporting</h3>
            <div class="net-rows">
                <div class="net-row"><span>Last Location Reported</span><span class="net-value gps-tester-last" data-gps-tester-last>None yet</span></div>
                <div class="net-meta" data-gps-tester-ago></div>
            </div>

            {% include 'driver/_gps_zones.html.twig' %}

            <div class="form-group">
                <label for="gps-test-stop">Test location: stop</label>
                <select id="gps-test-stop" class="input" data-gps-test-stop>
                    <option value="">Choose a stop…</option>
                </select>
            </div>

            <div class="form-group">
                <label for="gps-tester-place">Place</label>
                <div class="gps-tester-line">
                    <select id="gps-tester-place" class="input" data-gps-tester-place>
                        <option value="49.261111,-123.113889">Vancouver 49.261111, -123.113889</option>
                        <option value="49.1044,-122.8011">Surrey 49.1044, -122.8011</option>
                        <option value="49.2488,-122.9805">Burnaby 49.2488, -122.9805</option>
                    </select>
                    <button type="button" class="btn btn-primary" data-gps-tester-place-go>Go</button>
                </div>
            </div>

            <div class="form-group">
                <label for="gps-tester-distance">Move</label>
                <div class="gps-tester-line">
                    <select id="gps-tester-distance" class="input" aria-label="Distance" data-gps-tester-distance>
                        {% for n in [1, 2, 5, 10, 25, 50, 100, 250, 500] %}
                        <option value="{{ n }}"{% if n == 100 %} selected{% endif %}>{{ n }}</option>
                        {% endfor %}
                    </select>
                    <select class="input" aria-label="Unit" data-gps-tester-unit>
                        <option value="1" selected>m</option>
                        <option value="1000">km</option>
                    </select>
                    <select class="input" aria-label="Direction" data-gps-tester-direction>
                        <option value="north">North</option>
                        <option value="south">South</option>
                        <option value="east">East</option>
                        <option value="west">West</option>
                    </select>
                    <button type="button" class="btn btn-primary" data-gps-tester-move>Go</button>
                </div>
            </div>

            <div class="form-group">
                <label>Custom</label>
                <div class="gps-tester-line">
                    <input type="number" step="any" inputmode="decimal" class="input" placeholder="Lat" aria-label="Latitude" data-gps-tester-lat>
                    <input type="number" step="any" inputmode="decimal" class="input" placeholder="Long" aria-label="Longitude" data-gps-tester-lng>
                    <button type="button" class="btn btn-primary" data-gps-tester-custom-go>Go</button>
                </div>
            </div>

            <p class="text-faint" data-gps-tester-mode></p>
            <button type="button" class="btn btn-secondary btn-block" data-gps-tester-real>Use real GPS</button>
            <button type="button" class="btn btn-secondary btn-block mt" data-close>Close</button>
        </div>
    </div>
    {% endif %}

    {# Messages (GET /messages; tap = confirm read) #}
    <div class="messages-overlay" data-messages-overlay hidden>
        <div class="messages-panel">
            <div class="messages-header">
                <button type="button" class="icon-btn" data-messages-close aria-label="Back">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
                </button>
                <span class="messages-title">Messages</span>
            </div>
            <div class="messages-list" data-messages-list></div>
        </div>
    </div>
{% endblock %}

{% block scripts %}
    <script>
        window.SWD = {
            csrf: {{ csrf_token('driver_action')|json_encode|raw }},
            driverId: {{ app.user.id|json_encode|raw }},
            urls: {
                login: {{ path('app_driver_login')|json_encode|raw }},
                base: {{ path('app_driver_home')|json_encode|raw }},
                tasks: {{ path('app_driver_tasks')|json_encode|raw }}
            }
        };
    </script>
    <script src="/driver-app/js/app.js" defer></script>
    {% block page_scripts %}{% endblock %}
{% endblock %}
