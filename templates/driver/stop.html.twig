{% extends 'driver/app.html.twig' %}
{% import 'driver/_stop.html.twig' as ui %}
{#
    Figma "Destination Details" (driver): Company, Stop, Address (opens Google Maps directions), Phone Number,
    Special Instructions, Products, then "Mark Complete / Set Status". The spec adds: contact person, estimated
    ETA, the special note from dispatch (internal). The driver's steps (On my way / Arrived / Undo) follow the
    stop's next_allowed and can_undo from the Safeway Driver API.
#}

{% block title %}{{ stop.company }} — Safeway Driver{% endblock %}
{% block crumbs %} / <a href="{{ path('app_driver_tasks') }}">List Deliveries</a> / <span>Destination Details</span>{% endblock %}
{% block page_title %}Destination Details{% endblock %}

{% block content %}
    <div class="card" data-stop-id="{{ stop.id }}">
        <div class="field">
            <div class="field-label">Company:</div>
            <div class="field-value">{% if stop.rush %}<span class="rush" title="Rush">⚑</span> {% endif %}{{ ui.company(stop) }} {{ ui.status(stop) }}</div>
        </div>
        <div class="field">
            <div class="field-label">Stop:</div>
            <div class="field-value">#{{ stop.position }}</div>
        </div>
        <div class="field">
            <div class="field-label">Address:</div>
            <div class="field-value">{{ ui.address(stop) }}</div>
        </div>
        {% if stop.phone %}
        <div class="field">
            <div class="field-label">Phone Number:</div>
            <div class="field-value">{% if stop.tel %}<a class="field-link" href="{{ stop.tel }}">{{ stop.phone }}</a>{% else %}{{ stop.phone }}{% endif %}</div>
        </div>
        {% endif %}
        {% if stop.contact %}
        <div class="field">
            <div class="field-label">Contact Person:</div>
            <div class="field-value">{{ stop.contact }}</div>
        </div>
        {% endif %}
        <div class="field">
            <div class="field-label">Estimated ETA:</div>
            <div class="field-value">{{ stop.eta ?: '–' }}{{ stop.window ? ' · window ' ~ stop.window }}</div>
        </div>
        <div class="field">
            <div class="field-label">Special Instructions:</div>
            <div class="field-value">{{ stop.instructions ?: '—' }}</div>
        </div>
        {% if stop.dispatch_notes %}
        <div class="field">
            <div class="field-label">Note from Dispatch:</div>
            <div class="field-value">{% for n in stop.dispatch_notes %}<div>{{ n.text }}</div>{% endfor %}</div>
        </div>
        {% endif %}
        <div class="field">
            <div class="field-label">Products:</div>
            <div class="field-value">{{ ui.products(stop) }}</div>
        </div>
        {% if stop.my_notes %}
        <div class="field">
            <div class="field-label">Your Notes:</div>
            <div class="field-value">{% for n in stop.my_notes %}<div>{{ n.reason_code ? (n.reason_code|replace({'_': ' '})|capitalize ~ ': ') }}{{ n.text }}</div>{% endfor %}</div>
        </div>
        {% endif %}
        {% if stop.done %}
        <div class="field">
            <div class="field-label">Completed:</div>
            <div class="field-value">{{ stop.completed_at ?: 'Waiting to send' }}{{ stop.recipient_name ? ' · received by ' ~ stop.recipient_name }}</div>
        </div>
        {% if stop.photos %}
        <div class="field">
            <div class="field-label">Photo:</div>
            <div class="field-value photo-row">
                {% for p in stop.photos %}
                    {% if p.photo_id is defined and p.photo_id and not p.pending %}
                        <img src="{{ path('app_driver_photo', {photoId: p.photo_id}) }}" alt="Proof photo {{ loop.index }}" width="96" height="96" loading="lazy">
                    {% else %}
                        <span class="text-faint">Photo {{ loop.index }} still uploading</span>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        {% endif %}
        {% endif %}

        <div class="alert alert-danger" data-tap-error hidden role="alert"></div>
        <div class="stack">
            {% if 'on_my_way' in stop.next_allowed %}
                <button type="button" class="btn btn-primary btn-block" data-stop-tap="on-my-way">On My Way</button>
            {% endif %}
            {% if 'arrived' in stop.next_allowed %}
                <button type="button" class="btn btn-primary btn-block" data-stop-tap="arrived">Arrived</button>
            {% endif %}
            {% if 'complete' in stop.next_allowed %}
                <a class="btn btn-primary btn-block" href="{{ path('app_driver_complete', {id: stop.id}) }}">Mark Complete / Set Status</a>
            {% endif %}
            {% if 'note' in stop.next_allowed %}
                <a class="btn btn-warning btn-block" href="{{ path('app_driver_note', {id: stop.id}) }}">Add Note</a>
            {% endif %}
            {% if stop.can_undo %}
                <button type="button" class="btn btn-secondary btn-block" data-stop-tap="undo">Undo Last Step</button>
            {% endif %}
        </div>
    </div>
{% endblock %}

{% block page_scripts %}<script src="/driver-app/js/stop.js" defer></script>{% endblock %}
