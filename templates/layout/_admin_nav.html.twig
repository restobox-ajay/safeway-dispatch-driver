{% set cur = app.request.attributes.get('_route') %}
<div class="sidebar-brand-row"><a href="{{ path('app_admin_dashboard') }}" class="brand"><span class="brand-mark">FV</span> <span class="brand-text">Admin Panel</span></a></div>
<nav class="sidebar-nav">
    <div class="sidebar-section-label">Manage</div>
    <a href="{{ path('app_admin_dashboard') }}" class="{{ cur == 'app_admin_dashboard' ? 'active' }}">Dashboard</a>
    <a href="{{ path('app_admin_users') }}" class="{{ cur starts with 'app_admin_users' and cur != 'app_admin_users_invite' and cur != 'app_admin_users_invitations' ? 'active' }}">Users</a>
    <a href="{{ path('app_admin_users_invite') }}" class="{{ cur == 'app_admin_users_invite' ? 'active' }}">Invite User</a>
    <a href="{{ path('app_admin_users_invitations') }}" class="{{ cur == 'app_admin_users_invitations' ? 'active' }}">Invitations</a>
    <a href="{{ path('app_admin_audit_log') }}" class="{{ cur == 'app_admin_audit_log' ? 'active' }}">Audit Log</a>
    <a href="{{ path('app_admin_config') }}" class="{{ cur == 'app_admin_config' ? 'active' }}">Config</a>
    <a href="{{ path('app_admin_api_docs') }}" class="{{ cur starts with 'app_admin_api_docs' ? 'active' }}">API Docs</a>
    <a href="{{ path('app_admin_login_history') }}" class="{{ cur == 'app_admin_login_history' ? 'active' }}">Login History</a>
    <a href="{{ path('app_admin_account_sessions') }}" class="{{ cur starts with 'app_admin_account_sessions' ? 'active' }}">Active Sessions</a>
    <a href="{{ path('app_admin_api_tokens') }}" class="{{ cur starts with 'app_admin_api_tokens' ? 'active' }}">API Tokens</a>
    <a href="{{ path('app_admin_account_change_password') }}" class="{{ cur == 'app_admin_account_change_password' ? 'active' }}">Change Password</a>
    <a href="{{ path('app_admin_2fa_setup') }}" class="{{ cur starts with 'app_admin_2fa' ? 'active' }}">Two-Factor Auth</a>

    {% if is_granted('ROLE_SUPER_ADMIN') %}
        <div class="sidebar-section-label">Superadmin</div>
        <a href="{{ path('app_admin_superadmin_admins') }}" class="{{ cur == 'app_admin_superadmin_admins' ? 'active' }}">Manage Admins</a>
    {% endif %}

    {% if is_granted('ROLE_TECH_SUPPORT') %}
        <div class="sidebar-section-label">Maintainer</div>
        <a href="{{ path('app_admin_db_console') }}" class="{{ cur starts with 'app_admin_db' ? 'active' }}">DB Console</a>
        <a href="{{ path('app_admin_htaccess_lock') }}" class="{{ cur starts with 'app_admin_htaccess_lock' ? 'active' }}">Htaccess Lock</a>
    {% endif %}

    <div class="sidebar-divider"></div>
    <a href="{{ path('app_admin_logout') }}">Logout</a>
</nav>
